<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.zin.router-status-collector</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>/Users/zin/router-status/collector.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/zin/router-status</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/zin/router-status/collector.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/zin/router-status/collector.log</string>
</dict>
</plist>

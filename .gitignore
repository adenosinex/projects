# ============================================================
# projects monorepo .gitignore
# Rule: the repo holds SOURCE ONLY. No secrets, no credentials,
# no databases, no runtime data, no caches, no venvs.
# The sync script enforces the same excludes on the Mac side.
# ============================================================

# --- Secrets & credentials (NEVER commit) ---
.env
*.env
auth.json
*.secret
*.pem
*.key
*.crt
*.auth
*token*
*credential*
*password*
*cookie*
*session_secret*
sub.yaml
subscription.urls
# (config.py itself is clean source — credentials live in auth.json, excluded above)
# (config.example.py is a template and IS tracked)

# --- Local / runtime config (environment-specific, regenerable) ---
video_paths.json
client_token.json
localdy_client.json
localdy_sessions.json
localdy_client_state.json
localdy_client_pending.json
client_status.json
data.json
aliases.json

# --- Databases & runtime state ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
db/
downloads/
runs/
run/
logs/
*.log
sub-node/status/
experience.json
experience-v1.json
experience-udp.json
speed.json

# --- Media & datasets (not code) ---
*.m4a
*.mp3
*.mp4
*.mkv
audio_bilibili/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Node ---
node_modules/

# --- Build / archives / backups ---
*.tar.gz
*.zip
*.bak*
.buvid3

# --- OS ---
.DS_Store
Thumbs.db
